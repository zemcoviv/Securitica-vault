# Copy to .env and fill in. NEVER commit .env (BRIEF §9 — secrets via secrets).

# PostgreSQL password for Vaultwarden's database.
DB_PASSWORD=change-me-strong-random

# Telegram bot token (BotFather). Its leak = bot spoofing (BRIEF §6.2). Secret.
BOT_TOKEN=123456:replace-with-real-token

# Public HTTPS URL of the Mini App launch page.
MINIAPP_URL=https://vault.example.com/

# Comma-separated Telegram chat_ids allowed to use the bot (BRIEF §6.2).
ALLOWLIST_CHAT_IDS=111111111,222222222

# Vaultwarden admin panel token (optional; keep panel non-public via Caddy).
VW_ADMIN_TOKEN=

# Optional (BRIEF §6.2): path to a local GeoLite2-City.mmdb for geo in account
# event alerts. Leave empty to skip geo lookup entirely (default).
GEOIP_DB_PATH=
