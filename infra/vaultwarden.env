# Vaultwarden configuration (BRIEF §6.1).
# NOTE: secrets (ADMIN_TOKEN, DB password) belong in a real secrets store, not
# committed. This file documents the required non-secret settings; copy to
# vaultwarden.env.local and fill secrets there (see docker-compose env_file).

# --- Registration: invite-only, no open signups ---
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
# MUST be false (BRIEF §1): accounts are auto-provisioned by miniapp-server
# under a synthetic per-Telegram-user email (tg<id>@securitica.local, see
# server/provisioning.py) that never receives real mail. If this were true,
# Vaultwarden would require clicking an emailed verification link before
# login — which could never arrive — permanently locking every new user out.
SIGNUPS_VERIFY=false

# --- Public origin (served under /vault by Caddy) ---
DOMAIN=https://vault.example.com/vault

# --- Database (PostgreSQL) ---
# Supply the password via secret; this is the connection template.
# DATABASE_URL=postgresql://vaultwarden:CHANGE_ME@db:5432/vaultwarden

# --- Admin panel: token is REQUIRED (BRIEF §1 account auto-provisioning) ---
# ADMIN_TOKEN itself is set via docker-compose.yml (VW_ADMIN_TOKEN in .env),
# not here — it's also handed to miniapp-server, which calls the admin API
# server-to-server over the internal network to invite new Telegram users
# (server/vaultwarden_admin.py). The human-facing /admin PANEL should still
# be kept non-public at the edge (see Caddyfile) — this doesn't relax that.
DISABLE_ADMIN_TOKEN=false

# --- Hardening ---
WEBSOCKET_ENABLED=true
SHOW_PASSWORD_HINT=false
PASSWORD_ITERATIONS=600000
# Encourage Argon2id KDF on clients (BRIEF §5.1); clients pick KDF at setup.
ROCKET_PORT=80
LOG_LEVEL=warn
EXTENDED_LOGGING=true
