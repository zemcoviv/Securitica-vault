    "typecheck": "tsc --noEmit",
    "build:wordlists": "node scripts/build-wordlists.mjs"
  },
  "dependencies": {
    "hash-wasm": "^4.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "diceware-wordlist-en-eff": "^1.0.1",
    "diceware-wordlist-ru": "^1.0.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.6.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
