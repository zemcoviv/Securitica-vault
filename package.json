{
  "name": "securitica-vault-miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-knowledge Bitwarden-compatible vault client as a Telegram Mini App (M0-M4).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/inject-sri.mjs dist",
    "preview": "vite preview",
